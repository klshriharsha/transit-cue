# Used by the app/api/* Route Handlers (lib/config.ts).
# Copy this to .env.local and fill in real values for local development.

# For a local Supabase stack (`pnpm db:start`), set:
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_SERVICE_ROLE_KEY=<service_role key printed by `pnpm db:start` / `pnpm db:status`>
# Migration tooling (Supabase CLI) is configured separately — see supabase/README.md.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=replace-with-your-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-your-private-vapid-key

# Same public key as above, re-exposed to the browser so it can call PushManager.subscribe().
# Next.js inlines NEXT_PUBLIC_* vars at build time; keep this in sync with VAPID_PUBLIC_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-your-public-vapid-key

# Shared secret cron-job.org must send as `Authorization: Bearer <CRON_SECRET>` when it hits
# /api/cron. Generate one with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-secret

# Optional. Defaults shown / described below.
# TIMEZONE=Europe/Berlin
# LOG_LEVEL=info
